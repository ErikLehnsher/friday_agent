TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ADMIN_USER_IDS=
AGENT_PROJECT_DIR=/absolute/path/to/FridayAgentData/sessions
CLAUDE_BIN=claude
CLAUDE_MODEL=sonnet
CLAUDE_EFFORT=medium
CLAUDE_MAX_TURNS=16
CLAUDE_TIMEOUT_SECONDS=300
CODEX_BIN=codex
CODEX_MODEL=gpt-5.6-luna
CODEX_EFFORT=medium
CODEX_ENABLED=true
CODEX_TIMEOUT_SECONDS=300
AGENT_MODE=test
STORE_RAW_TRANSCRIPTS=true
WEB_ACCESS=full
BOT_DATA_DIR=/absolute/path/to/FridayAgentData/control
CHATGPT_DESKTOP_ENABLED=false
CHATGPT_DESKTOP_TIMEOUT_SECONDS=180
# Facebook Page credentials are entered in the local Friday Admin dashboard,
# never here. This controls only the private webhook listener.
FACEBOOK_HOST=0.0.0.0
FACEBOOK_PORT=8781
